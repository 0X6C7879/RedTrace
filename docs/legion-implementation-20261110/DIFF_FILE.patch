+  ]
+  if(!commander)tools.push(tool('legion_handoff', 'Request a fresh Agent/Run after saving STATE. Old execution must stop and all tool outcomes settle before automatic relay; never replay an unknown action.',Type.Object({summary:text,nextWorker:Type.Optional(text)}),args=>{if(args.nextWorker&&!config?.workers.some(w=>w.enabled&&w.name===args.nextWorker&&w.roles?.includes(store.node<Step>(projectId!,store.run(actor).stepId!,'step').role??'soldier')))throw new HttpError(422,'Replacement worker must be enabled and support the same role');return legion.queueHandoff(actor,args.summary,args.nextWorker)}))
+  const step = !commander ? store.node<Step>(projectId!, store.run(actor).stepId!, 'step') : undefined
+  if (commander || step?.role === 'general') tools.push(tool('legion_spawn', 'Create a role Mission using existing FGS/DSH execution. For the FIRST Scout use sourceIds=["origin"]: origin is the existing confirmed Scope Fact, so no bootstrap seed is missing. goalId is separate (root "goal"); Goal IDs are not sourceIds. Keep the same taskKey through Scout classification, General and its squads. General may delegate only same-task Soldier/Scout, within its Goal, at most two active squads.', Type.Object({ ...scope, role: Type.Union((commander ? ['general','soldier','scout'] : ['soldier','scout']).map(v => Type.Literal(v))), taskKey: text, description: text, sourceIds: Type.Array(text, { minItems: 1 }), goalId: Type.Optional(text), executionProfile: Type.Optional(Type.Union([Type.Literal('direct'),Type.Literal('isolated')])) }), args => { if(commander&&args.role==='general'){const task=legion.tactics(project(args)).find(t=>t.taskKey===args.taskKey);if(!task?.classification)throw new HttpError(409,'Record the completed Scout classification before funding General');if(task.classification.difficulty!=='hard'&&task.elapsedMs<20*60000)throw new HttpError(409,'General requires hard verdict or the funded escalation stage')} return legion.spawn(project(args), { ...args, ...(commander ? {} : { parentRunId: actor }) }, maxSteps) }))
+  if (commander) tools.push(
