+import test from'node:test'
+import assert from'node:assert/strict'
+import{Store}from'../src/store.ts'
+import{LegionStore}from'../src/legion-store.ts'
+function fixture(t:any){const store=new Store(':memory:'),legion=new LegionStore(store),p=store.createProject({title:'fixture',origin:'local',goal:'verify'}).project;t.after(()=>store.close());return{store,legion,p}}
+test('Commander is global, not one independent Decide Run per Project',t=>{const{store,legion,p}=fixture(t);store.createProject({title:'second',origin:'local',goal:'verify'});const c=legion.claimCommand();assert.equal(c.status,'running');assert.equal(store.runs(p.id).length,0);assert.throws(()=>legion.claimCommand(),/not idle/);assert.throws(()=>store.claim(p.id,'decide',{name:'retired',backend:'mock'}),/replaced by Commander/)})
+test('new deltas are per Project and only contiguous delivered cursors may be acknowledged',t=>{const{store,legion,p}=fixture(t),q=store.createProject({title:'other',origin:'local',goal:'verify'}).project;legion.claimCommand();const first=legion.readChanges(p.id);store.addFact(p.id,'later evidence');assert.throws(()=>legion.readChanges(p.id,first.cursor+2),/undelivered/);assert.throws(()=>legion.finishCommand({[p.id]:first.cursor+1},'state'),/exceeds/);legion.finishCommand({[p.id]:first.cursor},'confirmed state');assert.equal(legion.campaign().cursors[q.id],undefined);assert.equal(legion.campaign().cursors[p.id].acknowledged,first.cursor)})
+test('events arriving after the processed boundary remain pending for the next command cycle',t=>{const{store,legion,p}=fixture(t);legion.claimCommand();const page=legion.readChanges(p.id);store.addFact(p.id,'arrived after read');legion.finishCommand({[p.id]:page.cursor},'saved');legion.claimCommand();const next=legion.readChanges(p.id);assert.ok(next.cursor>page.cursor);assert.ok(next.events.some((x:any)=>x.type==='fact.added'))})
+test('reading deltas is not processing and stopped command retains its previous acknowledgement',t=>{const{legion,p}=fixture(t);legion.claimCommand();legion.readChanges(p.id);const c=legion.campaign();legion.saveCampaign({...c,status:'stopped',error:'native failure'});assert.equal(legion.campaign().cursors[p.id].acknowledged,0);assert.equal(legion.campaign().error,'native failure')})
+for(const kind of ['hint','observation'] as const)test(kind+' remains unverified but reaches Commander through graph delivery',t=>{const{store,legion,p}=fixture(t);legion.claimCommand();const page=legion.readChanges(p.id);store.addInput(p.id,kind,'unverified content');const next=legion.readChanges(p.id,page.cursor);assert.ok(next.events.some((x:any)=>x.type===kind+'.added'));assert.equal(store.nodeCount(p.id,'fact'),1)})
+test('Findings and evidence edits reach Commander without recursively executing Worker planners',t=>{const{store,legion,p}=fixture(t),f=store.addFact(p.id,'verified');legion.claimCommand();const page=legion.readChanges(p.id);store.addFinding(p.id,{title:'deliverable',description:'verified',factIds:[f.id]});const next=legion.readChanges(p.id,page.cursor);assert.ok(next.events.some((x:any)=>x.type==='finding.added'));legion.finishCommand({[p.id]:next.cursor},'processed');assert.equal(store.runs(p.id).length,0)})
+test('bounded pages cannot silently skip unread history',t=>{const{store,legion,p}=fixture(t);for(let i=0;i<5;i++)store.addFact(p.id,'fact '+i);legion.claimCommand();let page=legion.readChanges(p.id,undefined,1),pages=1;while(page.hasMore){page=legion.readChanges(p.id,page.cursor,1);pages++}assert.ok(pages>=5);legion.finishCommand({[p.id]:page.cursor},'all processed');assert.equal(legion.campaign().cursors[p.id].acknowledged,page.cursor)})
