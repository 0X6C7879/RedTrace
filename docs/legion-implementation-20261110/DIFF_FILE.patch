diff --git a/static/legion.css b/static/legion.css
new file mode 100644
index 0000000..b36da11
--- /dev/null
+++ b/static/legion.css
@@ -0,0 +1,123 @@
+/* Legion uses the existing RedTrace palette, with system typography for operational text. */
+.legion-console { height:100%; overflow:auto; background:var(--rt-bg-soft); color:var(--rt-text); font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; font-size:.875rem; line-height:1.6; }
+.legion-content { max-width:1440px; margin:auto; padding:clamp(1rem,3vw,2.5rem); }
+.legion-console h1,.legion-console h2,.legion-console h3 { font-family:inherit; color:var(--rt-text); letter-spacing:-.02em; line-height:1.3; }
+.legion-console h1 { font-size:1.75rem; font-weight:650; margin:.15rem 0 .5rem; }
+.legion-console h2 { font-size:1.1rem; font-weight:650; }
+.legion-console h3 { font-size:.9rem; font-weight:600; }
+.legion-heading { display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; flex-wrap:wrap; }
+.legion-eyebrow { color:var(--rt-coral-bright); font-size:.68rem; letter-spacing:.12em; font-weight:650; }
+.legion-muted { color:var(--rt-text-secondary); font-size:.8rem; line-height:1.6; margin:.5rem 0; overflow-wrap:anywhere; }
+.legion-card { border:1px solid var(--rt-border-soft); background:var(--rt-surface); padding:clamp(1rem,2vw,1.5rem); margin:1.25rem 0; border-radius:14px; }
+.legion-overview { border-color:var(--rt-border); }
+.legion-actions { display:flex; flex-wrap:wrap; align-items:center; gap:.5rem; }
+:is(.legion-console,.fgs-acceptance) .legion-button { display:inline-flex; justify-content:center; align-items:center; gap:.4rem; border:1px solid var(--rt-border); border-radius:8px; min-height:42px; padding:.45rem .85rem; background:var(--rt-surface-raised); color:var(--rt-text); font:600 .8rem/1.4 system-ui,sans-serif; cursor:pointer; touch-action:manipulation; }
+:is(.legion-console,.fgs-acceptance) .legion-button:hover:not(:disabled) { background:var(--rt-surface-active); border-color:var(--rt-text-muted); }
+:is(.legion-console,.fgs-acceptance) .legion-button:active:not(:disabled) { background:var(--rt-border); transform:scale(.98); transition:none; }
+:is(.legion-console,.fgs-acceptance) .legion-button:disabled { opacity:.45; cursor:not-allowed; transform:none; }
+:is(.legion-console,.fgs-acceptance) .legion-primary { background:var(--rt-coral); border-color:var(--rt-coral); color:#080b10; }
+:is(.legion-console,.fgs-acceptance) .legion-primary:hover:not(:disabled) { background:var(--rt-coral-bright); border-color:var(--rt-coral-bright); }
+.legion-badge { display:inline-block; font-size:.75rem; font-weight:600; border-radius:6px; padding:.15rem .5rem; background:var(--rt-border-soft); color:var(--rt-text-secondary); vertical-align:middle; }
+.legion-badge[data-state="running"],.legion-badge[data-state="admitted"],.legion-badge[data-state="target-verified"],.legion-badge[data-state="done"] { background:var(--rt-green-soft); color:var(--rt-green); }
