+const{runCommander}=await import(process.argv[2]??'../compat/legion.mjs')
+import{load}from'../../redtrace-dsh/lib/loader.js'
+const work=mkdtempSync(path.join(os.tmpdir(),'legion-commander-context-')),config=new Configuration(work);config.initialize();let compactions=0,finishes=0
+const model=createServer(async(req,res)=>{let text='';for await(const b of req)text+=b;const body=JSON.parse(text),summary=String(body.messages.at(-1)?.content??'').includes('You are now acting as a compaction engine');for(const name of ['read','write','edit','bash','pwsh','submit_fact'])assert.ok(!(body.tools??[]).some(t=>t.function.name===name));let delta;if(summary){compactions++;delta={content:'Confirmed STATE: local fixture only. No pending work or unknown calls. Next action: save STATE and finish the command cycle.'}}else if(!compactions){delta={tool_calls:[{index:0,id:'models',type:'function',function:{name:'legion_models',arguments:'{}'}}]}}else{finishes++;delta={tool_calls:[{index:0,id:'finish-'+finishes,type:'function',function:{name:'legion_finish',arguments:JSON.stringify({processed:{},state:'Confirmed STATE: local fixture accepted after native compaction; no execution pending.'})}}]}}res.writeHead(200,{'Content-Type':'text/event-stream'});res.end('data: '+JSON.stringify({id:'fixture',object:'chat.completion.chunk',created:1,model:'fixture',choices:[{index:0,delta,finish_reason:summary?'stop':'tool_calls'}]})+'\n\ndata: [DONE]\n\n')})
+const store=new Store(work+'/engine.db'),legion=new LegionStore(store);let ctx
+try{await new Promise(r=>model.listen(0,'127.0.0.1',r));config.commit(config.read().revision,raw=>{raw.providers={fixture:{api:'openai-completions',base_url:'http://127.0.0.1:'+model.address().port+'/v1',api_key:'fixture',models:[{id:'fixture',context_window:20000,max_tokens:512,reasoning:'off',reasoning_efforts:false}]}};raw.workers=[{name:'commander',roles:['commander'],provider:'fixture',model:'fixture'}]});const{Context}=await load('vendor/deepseek-harness/vendor/cordis/lib/index.js');ctx=new Context();for(const file of['vendor/deepseek-harness/packages/session/session-projection/lib/index.js','packages/redtrace-dsh/lib/core.js','vendor/deepseek-harness/packages/llm/token-meter/lib/index.js']){const m=await load(file);await ctx.plugin(m.default??m).await()}const persist=await load('vendor/deepseek-harness/packages/session/session-persistence-jsonl/lib/index.js');await ctx.plugin(persist,{root:work+'/sessions'}).await();const llm=await import('../compat/llm.mjs');await ctx.plugin(llm,{providers:providerProfiles(config.resolvedSnapshot().config).providers,credentialSource:{root:work,filename:config.filename,revision:config.read().revision}}).await();const compact=await load('vendor/deepseek-harness/packages/compaction/compaction-basic/lib/index.js');await ctx.plugin(compact.default??compact,{thresholdRatio:0.9,headroomTokens:256,maxTokens:512,retainTokens:0}).await();const old=legion.campaign();legion.saveCampaign({...old,state:'Confirmed local STATE and historical fixture data: '+Array.from({length:2600},(_,i)=>'known-'+i+' fixture evidence retained.').join(' ')});const engine={store,legion,configuration:config},worker=config.resolvedSnapshot().config.workers[0];const first=await runCommander(ctx,engine,worker,AbortSignal.timeout(20000));assert.notEqual(first.sessionId,old.sessionId);assert.equal(first.previousSessionId,old.sessionId);const second=await runCommander(ctx,engine,worker,AbortSignal.timeout(20000));assert.equal(second.sessionId,first.sessionId,'A successor must not recompact the same old STATE forever');assert.equal(finishes,1);assert.equal(compactions,1);assert.ok(second.state.includes('accepted after native compaction'));console.log('COMMANDER_NATIVE_RELAY=true; native_compaction=1; fresh_session=true; successor_finishes=true; no_recursive_state_growth=true')}finally{console.error(JSON.stringify({compactions,finishes}));await ctx?.fiber.dispose();store.close();await new Promise(r=>model.close(r));rmSync(work,{recursive:true,force:true})}
