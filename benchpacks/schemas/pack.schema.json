{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "benchpack pack.toml",
  "type": "object",
  "required": ["schema", "id", "adapter", "python", "credentials"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "adapter": {
      "type": "object",
      "required": ["module", "class"],
      "properties": { "module": { "type": "string" }, "class": { "type": "string" } }
    },
    "skill": {
      "type": "object",
      "properties": { "entrypoint": { "type": "string" }, "name": { "type": "string" } }
    },
    "python": {
      "type": "object",
      "required": ["dependencies"],
      "properties": {
        "requires": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } }
      }
    },
    "credentials": {
      "type": "object",
      "properties": {
        "config_file": { "type": "string" },
        "required": { "type": "array", "items": { "type": "string" } }
      }
    },
    "capabilities": { "type": "object" },
    "answer": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "pattern": { "type": "string" },
        "multiple": { "type": "boolean" }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "state_file": { "type": "string" },
        "close_task_on_completion": { "type": "boolean" },
        "close_task_on_runner_exit": { "type": "boolean" },
        "delete_runtime_on_exit": { "type": "boolean", "const": false },
        "delete_results_on_exit": { "type": "boolean", "const": false }
      }
    }
  }
}
