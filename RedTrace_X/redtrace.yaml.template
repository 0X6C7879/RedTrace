# RedTrace_X 本地模式运行配置模板。
# 敏感值（模型 API Key / 平台 Token）用环境变量占位，由 start.sh 渲染为 redtrace.yaml。
# 模型网关：https://agent-awd.baidu.com，模型 glm-5.2-agent-chanllenge，Bearer 鉴权。
#   Claude Code  → Anthropic Messages 协议 (/v1/messages)
#   Codex        → OpenAI Responses 协议   (/v1/responses)
#   Pi           → OpenAI Chat Completions (/v1/chat/completions)
# 并发：reason.max_intents=3，explore worker 共 3 路（claude×2 + codex×1），pi 专职 reason。
server: http://127.0.0.1:8000
runtime:
  execution: local
  worker_healthcheck: disabled
  max_workers: 4
  max_running_projects: 2
  max_project_workers: 4
  interval: 3
  healthcheck_timeout: 60
  prompt_group: default
tasks:
  bootstrap:
    timeout: 600
    conclude_timeout: 120
  reason:
    timeout: 300
    max_intents: 3
  explore:
    timeout: 1800
    conclude_timeout: 300
context_harness:
  enabled: true
  artifact_root: .redtrace/artifacts/context
  inline_bytes: 524288
  visible_bytes: 131072
  query_bytes: 2097152
  parse_bytes: 134217728
  worker_output_chars: 16777216
local:
  completed_action: keep
common_env:
  BENCHMARK_TOKEN: ${BENCHMARK_TOKEN}
  BENCHMARK_BASE_URL: ${BENCHMARK_BASE_URL}
  VPN_CHECK_URL: ${VPN_CHECK_URL}
workers:
- name: pi-reason
  type: pi
  enabled: true
  task_types:
  - reason
  - bootstrap
  max_running: 1
  priority: 0
  env:
    PI_BASE_URL: ${AGENT_BASE_URL}/v1
    PI_MODEL: ${MODEL}
    PI_API_KEY: ${API_KEY}
    PI_PROVIDER_API: openai-completions
- name: claude-explore
  type: claudecode
  enabled: true
  task_types:
  - explore
  max_running: 2
  priority: 1
  env:
    ANTHROPIC_BASE_URL: ${AGENT_BASE_URL}
    ANTHROPIC_MODEL: ${MODEL}
    ANTHROPIC_AUTH_TOKEN: ${API_KEY}
- name: codex-explore
  type: codex
  enabled: true
  task_types:
  - explore
  max_running: 1
  priority: 2
  env:
    CODEX_BASE_URL: ${AGENT_BASE_URL}/v1
    CODEX_MODEL: ${MODEL}
    OPENAI_API_KEY: ${API_KEY}
paths:
  root: .
  skills: skills
  mcp: mcp
  plugins: plugins
  managed: .redtrace
  workspaces: workspaces
  audit: .redtrace/audit
