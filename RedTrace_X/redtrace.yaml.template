# RedTrace_X 本地模式运行配置模板。
# 敏感值（模型 API Key / 平台 Token）用环境变量占位，由 start.sh 渲染为 redtrace.yaml。
# 模型网关 https://agent-awd.baidu.com / glm-5.2-agent-chanllenge / Bearer 鉴权；
# Worker 全部为 Pi，走 OpenAI Chat Completions 协议(/v1/chat/completions)：
#   reason.max_intents=3；池 = 1×Pi(reason+bootstrap) + 3×Pi(explore)。
# 本镜像/工程不再安装、不配置 Codex / Claude Code 工作环境。
server: http://127.0.0.1:8000
runtime:
  execution: local
  worker_healthcheck: disabled
  max_workers: 4
  max_running_projects: 1
  max_project_workers: 4
  interval: 3
  healthcheck_timeout: 60
  prompt_group: default
tasks:
  bootstrap:
    timeout: 600
    conclude_timeout: 120
  reason:
    timeout: 300
    max_intents: 3
  explore:
    timeout: 1800
    conclude_timeout: 300
context_harness:
  enabled: true
  artifact_root: .redtrace/artifacts/context
  inline_bytes: 524288
  visible_bytes: 131072
  query_bytes: 2097152
  parse_bytes: 134217728
  worker_output_chars: 16777216
local:
  completed_action: keep
common_env:
  BENCHMARK_TOKEN: ${BENCHMARK_TOKEN}
  BENCHMARK_BASE_URL: ${BENCHMARK_BASE_URL}
  VPN_CHECK_URL: ${VPN_CHECK_URL}
workers:
- name: pi-reason
  type: pi
  enabled: true
  task_types:
  - reason
  - bootstrap
  max_running: 1
  priority: 0
  env:
    PI_BASE_URL: ${AGENT_BASE_URL}/v1
    PI_MODEL: ${MODEL}
    PI_API_KEY: ${API_KEY}
    PI_PROVIDER_API: openai-completions
- name: pi-explore-1
  type: pi
  enabled: true
  task_types:
  - explore
  max_running: 1
  priority: 1
  env:
    PI_BASE_URL: ${AGENT_BASE_URL}/v1
    PI_MODEL: ${MODEL}
    PI_API_KEY: ${API_KEY}
    PI_PROVIDER_API: openai-completions
- name: pi-explore-2
  type: pi
  enabled: true
  task_types:
  - explore
  max_running: 1
  priority: 1
  env:
    PI_BASE_URL: ${AGENT_BASE_URL}/v1
    PI_MODEL: ${MODEL}
    PI_API_KEY: ${API_KEY}
    PI_PROVIDER_API: openai-completions
- name: pi-explore-3
  type: pi
  enabled: true
  task_types:
  - explore
  max_running: 1
  priority: 1
  env:
    PI_BASE_URL: ${AGENT_BASE_URL}/v1
    PI_MODEL: ${MODEL}
    PI_API_KEY: ${API_KEY}
    PI_PROVIDER_API: openai-completions
paths:
  root: .
  skills: skills
  mcp: mcp
  plugins: plugins
  managed: .redtrace
  workspaces: workspaces
  audit: .redtrace/audit
