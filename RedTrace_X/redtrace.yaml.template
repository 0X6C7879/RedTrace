# RedTrace_X 本地模式运行配置。
# 只有三项为评测平台下发的机密、必须由进程环境变量提供：
#   BENCHMARK_TOKEN / BENCHMARK_BASE_URL / API_KEY。
# 其中 API_KEY 在调度器加载时回退填入各 Pi worker 的 PI_API_KEY（见 dispatcher/config.py）；
# 平台凭证则随子进程(os.environ 继承)透传给 agent 跑的 benchctl 子命令使用。
# 其它多为公开常量，作为缺省值写死于此：模型网关根地址（AGENT_BASE_URL）、模型名
# （MODEL）在调度器加载时若平台已下发则覆盖下方各 Pi worker 的 PI_BASE_URL /
# PI_MODEL（自动补 /v1）；VPN 探针可由 VPN_CHECK_URL 覆盖。详见 dispatcher/config.py。
#
# 模型网关走 OpenAI Chat Completions 协议(/v1/chat/completions)，Pi 全量开启 1M 上下文：
#   reason.max_intents=3；池 = 1×Pi(reason+bootstrap) + 3×Pi(explore)。本镜像不再安装 Codex/Claude Code。
server: http://127.0.0.1:8000
runtime:
  execution: local
  worker_healthcheck: disabled
  max_workers: 4
  max_running_projects: 1
  max_project_workers: 4
  interval: 3
  healthcheck_timeout: 60
  prompt_group: default
tasks:
  bootstrap:
    timeout: 600
    conclude_timeout: 120
  reason:
    timeout: 300
    max_intents: 3
  explore:
    timeout: 1800
    conclude_timeout: 300
context_harness:
  enabled: true
  artifact_root: .redtrace/artifacts/context
  inline_bytes: 524288
  visible_bytes: 131072
  query_bytes: 2097152
  parse_bytes: 134217728
  worker_output_chars: 16777216
local:
  completed_action: keep
workers:
- name: pi-reason
  type: pi
  enabled: true
  task_types:
  - reason
  - bootstrap
  max_running: 1
  priority: 0
  context_length: 1048576   # 1M tokens
  env:
    PI_PROVIDER_API: openai-completions
    PI_BASE_URL: https://agent-awd.baidu.com/v1
    PI_MODEL: glm-5.2-agent-chanllenge     # 公开常量；PI_API_KEY 从环境变量 API_KEY 注入，不入库
- name: pi-explore-1
  type: pi
  enabled: true
  task_types:
  - explore
  max_running: 1
  priority: 1
  context_length: 1048576   # 1M tokens
  env:
    PI_PROVIDER_API: openai-completions
    PI_BASE_URL: https://agent-awd.baidu.com/v1
    PI_MODEL: glm-5.2-agent-chanllenge     # 公开常量；PI_API_KEY 从环境变量 API_KEY 注入，不入库
- name: pi-explore-2
  type: pi
  enabled: true
  task_types:
  - explore
  max_running: 1
  priority: 1
  context_length: 1048576   # 1M tokens
  env:
    PI_PROVIDER_API: openai-completions
    PI_BASE_URL: https://agent-awd.baidu.com/v1
    PI_MODEL: glm-5.2-agent-chanllenge     # 公开常量；PI_API_KEY 从环境变量 API_KEY 注入，不入库
- name: pi-explore-3
  type: pi
  enabled: true
  task_types:
  - explore
  max_running: 1
  priority: 1
  context_length: 1048576   # 1M tokens
  env:
    PI_PROVIDER_API: openai-completions
    PI_BASE_URL: https://agent-awd.baidu.com/v1
    PI_MODEL: glm-5.2-agent-chanllenge     # 公开常量；PI_API_KEY 从环境变量 API_KEY 注入，不入库
paths:
  root: .
  skills: skills
  mcp: mcp
  plugins: plugins
  managed: .redtrace
  workspaces: workspaces
  audit: .redtrace/audit
