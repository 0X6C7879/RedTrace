#!/usr/bin/env bash
set -euo pipefail

candidates=(
  "${REDTRACE_QILING_VENV:-}"
  "${QILING_VENV:-}"
  "$HOME/.local/share/redtrace-qiling"
  "$HOME/.ctf-tools/qiling-venv"
)

for candidate in "${candidates[@]}"; do
  [[ -n "$candidate" && -x "$candidate/bin/python" ]] || continue
  exec "$candidate/bin/python" "$@"
done

printf 'qiling-python: no verified Qiling environment found\n' >&2
exit 1
