{
  "$comment": "Single source of truth for api-audit/mr-review/report-review JSON output structure. validate-output.cjs reads this file directly and interprets it — there is no second copy of these rules to keep in sync. category enum values are sourced from references/common/category-enum.md.",
  "category_enum": [
    "SQLi", "NoSQLi", "RCE", "SSRF", "XSS", "PathTraversal", "FileUpload",
    "XXE", "Deserialization", "OpenRedirect", "CORS", "Hardcoded", "IDOR",
    "PrivateVideo", "PrivateAccount", "SSTI", "FormatString", "WebEnableDebug",
    "IntegerOverflow", "WeakRNG", "PrototypePollution", "JWT",
    "BrokenAccessControl", "CSRF", "PromptInjection", "BusinessLogic",
    "BatchExport", "LDAPi", "JDBCi", "XPathInjection", "CRLFi", "GraphQLi",
    "SwaggerMisconfig"
  ],
  "severity_enum": ["critical", "high", "medium", "low", "info"],
  "conclusion_enum": ["vulnerability", "risk-a", "risk-b", "safe", "unknown"],
  "audit_status_enum": ["PASS", "BLOCK", "WARNING"],
  "verdict_enum": ["TRUE_POSITIVE", "FALSE_POSITIVE", "CANNOT_VERIFY"],

  "finding_schema": {
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "category": { "type": "string" },
      "conclusion": { "type": "string" },
      "severity": { "type": "string" },
      "entry_point": { "type": "string" },
      "root_cause": { "type": "string" },
      "affected_locations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "file_path": { "type": "string" },
            "line_number": { "type": "integer" }
          },
          "required": ["file_path", "line_number"],
          "additionalProperties": false
        }
      },
      "description": { "type": "string" },
      "recommendation": { "type": "string" },
      "confidence": { "type": "number" },
      "occurrences": { "type": "integer" },
      "data_flow": { "type": "string" },
      "example_payload": { "type": "array" }
    },
    "required": ["id", "category", "conclusion", "severity", "entry_point", "root_cause", "affected_locations", "description", "recommendation", "confidence", "occurrences"],
    "additionalProperties": false
  },

  "passed_check_schema": {
    "type": "object",
    "properties": {
      "type": { "type": "string" },
      "reason": { "type": "string" }
    },
    "required": ["type", "reason"],
    "additionalProperties": false
  },

  "summary_schema": {
    "type": "object",
    "properties": {
      "functional_impact": { "type": "string" },
      "vulnerabilities_count": { "type": "integer" },
      "risks_count": { "type": "integer" },
      "audit_status": { "type": "string" },
      "overall_severity": { "type": "string" },
      "key_findings": { "type": "array" }
    },
    "required": ["functional_impact", "vulnerabilities_count", "risks_count", "audit_status", "overall_severity", "key_findings"],
    "additionalProperties": false
  },

  "findings_schema": {
    "type": "object",
    "properties": {
      "vulnerabilities": { "type": "array" },
      "risks": { "type": "array" },
      "passed_checks": { "type": "array" }
    },
    "required": ["vulnerabilities", "risks", "passed_checks"],
    "additionalProperties": false
  },

  "api_audit_top_schema": {
    "type": "object",
    "properties": {
      "findings": { "$ref": "findings_schema" },
      "summary": { "$ref": "summary_schema" }
    },
    "required": ["findings", "summary"],
    "additionalProperties": false
  },

  "review_item_schema": {
    "type": "object",
    "properties": {
      "review_id": { "type": ["string", "integer"] },
      "api_path": { "type": "string" },
      "http_method": { "type": "string" },
      "original_severity": { "type": "string" },
      "new_severity": { "type": "string" },
      "changed": { "type": "boolean" },
      "change_reason": { "type": "string" },
      "updated_result": { "type": "object" }
    },
    "required": ["review_id", "api_path", "http_method", "original_severity", "new_severity", "changed"],
    "additionalProperties": false
  },

  "report_review_summary_schema": {
    "type": "object",
    "properties": {
      "total_reviewed": { "type": "integer" },
      "upgraded": { "type": "integer" },
      "downgraded": { "type": "integer" },
      "unchanged": { "type": "integer" },
      "unchanged_reasons": { "type": "array" }
    },
    "required": ["total_reviewed", "upgraded", "downgraded", "unchanged"],
    "additionalProperties": false
  },

  "report_review_top_schema": {
    "type": "object",
    "properties": {
      "reviews": { "type": "array" },
      "summary": { "$ref": "report_review_summary_schema" }
    },
    "required": ["reviews", "summary"],
    "additionalProperties": false
  }
}
