+/**
+ * Resolve the shell executable and its "run a command" flag.
+ *
+ * Resolution order (Unix):
+ *   1. DSH_SHELL env var (set by the RedTrace launcher from the parent shell)
+ *   2. platform default: /bin/bash (macOS), /bin/sh (other Unix)
+ *
+ * Windows:
+ *   - cmd.exe → [comspec, '/c']
+ *   - PowerShell → [shell, '-Command']
+ */
+function resolveShell(): { exe: string; flag: string } {
+  const envShell = process.env.DSH_SHELL
+  if (envShell) {
+    const name = envShell.toLowerCase()
+    if (name.includes('powershell') || name.includes('pwsh'))
+      return { exe: envShell, flag: '-Command' }
+    if (name.endsWith('cmd') || name.endsWith('cmd.exe'))
+      return { exe: envShell, flag: '/c' }
+    // Unix-family shells (bash, zsh, sh, fish, …) all support -c.
+    return { exe: envShell, flag: '-c' }
+  }
+  // No DSH_SHELL — fall back to platform defaults.
+  if (process.platform === 'win32') {
+    const comspec = process.env.ComSpec
+    return { exe: comspec ?? 'cmd.exe', flag: '/c' }
+  }
+  // Absolute path avoids the bare-name ENOENT that started this whole fix.
+  // /bin/bash exists on both macOS (GPLv2-era 3.2) and Linux.
+  return { exe: '/bin/bash', flag: '-c' }
+}
+
+/** Cached per-process shell resolution (the parent shell does not change). */
+let _cachedShell: { exe: string; flag: string } | undefined
 
+export function shellArgv(command: string): readonly string[] {
+  _cachedShell ??= resolveShell()
+  return [_cachedShell.exe, _cachedShell.flag, command]
