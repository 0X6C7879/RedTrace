{
  "agents": {
    "codex": {
      "startup_timeout_sec": 60
    }
  },
  "args": [
    "-y",
    "chrome-devtools-mcp@latest",
    "--headless",
    "--isolated",
    "--no-usage-statistics",
    "--no-performance-crux",
    "--chromeArg=--no-sandbox",
    "--chromeArg=--disable-dev-shm-usage",
    "--chromeArg=--disable-gpu"
  ],
  "command": "npx",
  "enabled": true,
  "env": {
    "CI": "1"
  },
  "transport": "stdio"
}
