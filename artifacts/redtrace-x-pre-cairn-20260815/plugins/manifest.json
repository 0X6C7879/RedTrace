{
  "schemaVersion": 1,
  "plugins": [
    {
      "id": "cyberstrikeai-browser-extension",
      "name": "CyberStrikeAI Browser Extension for RedTrace",
      "kind": "chromium-devtools",
      "version": "0.3.10-redtrace.1",
      "description": "Capture browser traffic and submit scoped analysis tasks to RedTrace.",
      "path": "plugins/browser-extension/cyberstrikeai-browser-extension",
      "entrypoint": "manifest.json",
      "build": "package.sh",
      "legacyProtocol": "cyberstrikeai-v1",
      "enabled": true,
      "agents": [
        "claude",
        "codex",
        "pi"
      ]
    },
    {
      "id": "cyberstrikeai-burp-extension",
      "name": "CyberStrikeAI Burp Suite Extension for RedTrace",
      "kind": "burp-suite",
      "version": "1.0.0-redtrace.1",
      "description": "Send Burp Suite traffic to RedTrace for shared Worker analysis.",
      "path": "plugins/burp-suite/cyberstrikeai-burp-extension",
      "entrypoint": "src/main/java/burp/BurpExtender.java",
      "build": "build-mvn.sh",
      "legacyProtocol": "cyberstrikeai-v1",
      "enabled": true,
      "agents": [
        "claude",
        "codex",
        "pi"
      ]
    }
  ]
}
